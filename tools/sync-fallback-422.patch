diff --git a/tests/test.StoragePrefs.js b/tests/test.StoragePrefs.js
index 14029e6..9be7b13 100644
--- a/tests/test.StoragePrefs.js
+++ b/tests/test.StoragePrefs.js
@@ -187,3 +187,42 @@ describe('MigratePrefs (globals.js)', () => {
 		expect(run('globalThis.__errors')[0]).toMatch(/MigratePrefs\(\) failed.*quota exceeded/);
 	});
 });
+
+describe('sync storage turned off in the browser (#422)', () => {
+	/** Firefox with webextensions.storage.sync.enabled = false (and Tor Browser) rejects every sync storage call */
+	async function setupSyncOff(local = {}) {
+		let browser = makeBrowser({ local });
+		for(let method of ['get', 'set', 'remove'])
+			browser.storage.sync[method] = jest.fn(async () => { throw new Error('Please set webextensions.storage.sync.enabled to true in about:config'); });
+
+		let { run } = loadScripts(['StoragePrefs.js', 'globals.js'], browser);
+		let prefs   = run('(Defaults) => new StoragePrefs(Defaults, { StorageAPI: "auto" })')(Defaults);
+
+		await prefs.Ready;
+
+		return { prefs, browser };
+	}
+
+	test('the settings load from local storage instead', async () => {
+		let { prefs } = await setupSyncOff({ Alpha: 'from-local' });
+
+		expect(prefs.Alpha).toBe('from-local');
+		expect(prefs.StorageAPI).toBe('local');
+		expect(prefs.SyncUnavailable).toBe(true);
+	});
+
+	test('changes are saved to local storage', async () => {
+		let { prefs, browser } = await setupSyncOff();
+
+		prefs.Alpha = 5;
+		await flush();
+
+		expect(browser.storage.local.data.Alpha).toBe(5);
+	});
+
+	test('SyncUnavailable is false while sync storage works', async () => {
+		let { prefs } = await setup();
+
+		expect(prefs.SyncUnavailable).toBe(false);
+	});
+});
